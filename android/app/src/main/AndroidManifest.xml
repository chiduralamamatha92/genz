<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- v7.43: "when locked screen not coming" — see CallPollService's
             docblock. A separate native background service (not the
             WebView/app.js) that keeps polling for incoming calls and can
             post a real Android notification even when the screen is
             locked, since the WebView's own JS gets frozen in that state.
             foregroundServiceType="dataSync" is the closest standard fit
             for "periodically fetches data in the background"; it does not
             restrict what kind of notification the service is allowed to
             post (that's governed by the notification's own channel/
             priority/full-screen-intent, set in code). -->
        <service
            android:name=".CallPollService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- v7.63: "whatsapp/telegram calling laga kavali" — see
             IncomingCallActivity.java's docblock for the full story. The
             showWhenLocked/turnScreenOn attributes here are the manifest-
             level half of letting this screen actually appear over the
             lock screen (paired with the runtime setShowWhenLocked()/
             setTurnScreenOn() calls in the Activity itself, for API<27
             devices and as a belt-and-braces fallback); excludeFromRecents
             keeps a dismissed/answered call screen from lingering in the
             recent-apps list. singleTask so a second incoming call while
             this is already showing updates the same instance rather than
             stacking a duplicate. -->
        <activity
            android:name=".IncomingCallActivity"
            android:theme="@style/AppTheme.IncomingCall"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="false" />

        <!-- v7.62, Part B (FCM): see FcmService.java's docblock. Purely a
             fast "wake up and poll now" nudge to the existing
             CallPollService above — does not show its own notification
             and does not touch backend/api/calls/*. -->
        <service
            android:name=".FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed for WebRTC calling (mic/camera) and camera-flip during video calls -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed for the Nearby feature (navigator.geolocation in the web app).
         Without these, Android's WebView silently denies every geolocation
         request no matter what the in-page prompt shows — see the
         onGeolocationPermissionsShowPrompt override in MainActivity.java. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- v7.43: for CallPollService, the native "screen off ringing" fallback —
         see its docblock in CallPollService.java. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the incoming-call notification wake/show over a locked screen.
         On Android 14+ this may still need one manual toggle from the user:
         Settings → Apps → GenZ → Notifications → "Full screen notifications". -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
</manifest>
